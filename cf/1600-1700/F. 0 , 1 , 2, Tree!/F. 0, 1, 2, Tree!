void solve(){
     int a , b , c ; cin >> a >> b >> c ;   
     
     // tree edges  =  n - 1  = a+b+c-1   
     // is same as 2*a + b
     if ( a + 1 != c ){
     		put(-1) ;  
     		return  ; 
     }
     if(a == 0 && b == 0 && c==1){
     	put(0) ;  
     	return ;  
     }
     int h  = 0  ;  
     int curr = 1 ;   
     while(a-curr>=0){
     	a -= curr ;  
     	curr *= 2 ;  
     	h++ ;  
     }
     if(a+b>0)h++ ;  
     int a_in_layer = a ;   
     int rem = curr - a ;   
     int b_in_layer = min(b,rem) ;  
     b -= b_in_layer ;  
     
     int next = (a_in_layer*2)  + b_in_layer ;   
     
     if(b>0){ // only b levels
     	h += b/next ;   
     	if(b%next!=0)h++ ;   
     }
      
     put(h) ;
}


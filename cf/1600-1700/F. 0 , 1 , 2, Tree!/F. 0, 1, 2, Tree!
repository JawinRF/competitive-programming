struct node{
	node *l , *r ; 
	int degree  ;   
	node(int d){ // degree 
		degree = d ; 
		l = r = NULL ; 
	} 
};  
void solve(){
     int a , b , c ; cin >> a >> b >> c ;   
     if(a == 0 ){ 
     	if(c!=1){
     		put(-1) ;   
     	}
     	else put(b+c-1) ;  
     	return ;  
     }
     int mxdepth = 0 ; 
     node* root = new node(2) ; 
     a-- ;   
     queue<pair<node*,int>> q ;   
     q.emplace(root,0) ;  
     while(!q.empty()){
     	auto [curr,d] = q.front() ;  
     	q.pop() ;  
     	mxdepth = max(mxdepth,d) ;   
     	if(curr->degree == 0)continue ;  
    
     	if(a>0){
     		a-- ; 
     		curr->l = new node(2)  ;
     	}
     	else if(b>0){
     		b-- ; 
     		curr->l = new node(1)  ; 
     	}
     	else if(c>0){
     		c-- ; 
     		curr->l = new node(0)  ;
     	}else{
     		put(-1) ;  
     		return ;   
     	}
     	q.emplace(curr->l,d+1) ; 
     	if(curr->degree==2){
	     	if(a>0){
	     		a-- ; 
	     		curr->r = new node(2)  ;
	     	}
	     	else if(b>0){
	     		b-- ; 
	     		curr->r = new node(1)  ; 
	     	}
	     	else if(c>0){
	     		c-- ; 
	     		curr->r = new node(0)  ;
	     	}
	     	else{
	     		put(-1) ;  
	     		return ;  
	     	}
	     	q.emplace(curr->r,d+1) ; 
	}
	
	} 
	if(a || b || c ){
		put(-1) ;  
		return  ;
	}
	put(mxdepth) ; 
}
 


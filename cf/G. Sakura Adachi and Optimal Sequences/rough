void solve(){
    int n ; cin >> n  ; 
    vector<int> a(n) , b(n) ; read(a) ; read(b) ;  
    int minOp = INT_MAX;  
    for(int k = 0 ; k<= 20 ; ++k){
        int curr = 0 ; 
        int flag = 0 ;
        for(int i = 0 ; i<n ; ++i){
            int sum = b[i] - (a[i]<<k) ; 
            if(sum<0){
                flag = 1 ; 
                break ; 
            }
            for(int j = 0 ; j<=k ; ++j){
                int t = (sum>>(k-j)) ; 
                curr += t ; 
                sum -= (t<<(k-j)) ;  
            }
        }
        if(!flag)minOp = min(k+curr,minOp) ; 
    }
    put(minOp)
}


